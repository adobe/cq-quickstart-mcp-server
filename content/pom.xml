<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ====================================================================== -->
    <!-- P A R E N T  P R O J E C T  D E S C R I P T I O N                      -->
    <!-- ====================================================================== -->
    <parent>
        <groupId>com.adobe.aem</groupId>
        <artifactId>parent-oss</artifactId>
        <version>10</version>
        <relativePath />
    </parent>

    <!-- ====================================================================== -->
    <!-- P R O J E C T  D E S C R I P T I O N                                   -->
    <!-- ====================================================================== -->
    <groupId>com.adobe.aem</groupId>
    <artifactId>com.adobe.aem.mcp-server-contribs-content</artifactId>
    <packaging>content-package</packaging>
    <name>Adobe Experience Manager MCP Server Contributions Content Package</name>
    <version>0.2.1-SNAPSHOT</version>
    <description>Content package for the AEM MCP Server Contributions module</description>

    <scm>
        <connection>scm:git:https://github.com/adobe/cq-quickstart-mcp-server.git</connection>
        <developerConnection>scm:git:https://github.com/adobe/cq-quickstart-mcp-server.git</developerConnection>
        <url>https://github.com/adobe/cq-quickstart-mcp-server</url>
        <tag>HEAD</tag>
    </scm>

    <!-- ====================================================================== -->
    <!-- P R O P E R T I E S                                                    -->
    <!-- ====================================================================== -->
    <properties>
        <aem.host>localhost</aem.host>
        <aem.port>4502</aem.port>
        <aem.publish.port>4503</aem.publish.port>
        <vault.package.version>${project.version}</vault.package.version>
        <vault.package.group>adobe/cq</vault.package.group>
        <vault.package.company>Adobe Systems</vault.package.company>
    </properties>

    <!-- ====================================================================== -->
    <!-- B U I L D   D E F I N I T I O N                                        -->
    <!-- ====================================================================== -->
    <build>
        <plugins>
            <!-- ====================================================================== -->
            <!-- F I L E V A U L T   P A C K A G E   P L U G I N                        -->
            <!-- ====================================================================== -->
            <plugin>
                <groupId>org.apache.jackrabbit</groupId>
                <artifactId>filevault-package-maven-plugin</artifactId>
                <version>1.4.0</version>
                <extensions>true</extensions>
                <configuration>
                    <group>${vault.package.group}</group>
                    <requiresRoot>true</requiresRoot>
                    <accessControlHandling>ignore</accessControlHandling>

                    <!-- Package properties surfaced in properties.xml -->
                    <properties>
                        <description>${project.description}</description>
                        <createdBy>${vault.package.company}</createdBy>
                    </properties>

                    <!-- Embed only the main bundle -->
                    <!-- Note: All dependencies are embedded inline in the bundle JAR itself -->
                    <embeddeds>
                        <embedded>
                            <groupId>com.adobe.aem</groupId>
                            <artifactId>com.adobe.aem.mcp-server-contribs</artifactId>
                            <target>apps/mcp-server-contribs/install</target>
                        </embedded>
                    </embeddeds>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- ====================================================================== -->
    <!-- D E P E N D E N C I E S                                                -->
    <!-- ====================================================================== -->
    <dependencies>
        <!-- MCP Server Bundle - our main bundle (contains all dependencies embedded inline) -->
        <dependency>
            <groupId>com.adobe.aem</groupId>
            <artifactId>com.adobe.aem.mcp-server-contribs</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <!-- ====================================================================== -->
    <!-- P R O F I L E S                                                        -->
    <!-- ====================================================================== -->
    <profiles>
        <!-- ============================================================== -->
        <!-- A U T O I N S T A L L  P A C K A G E  ( A U T H O R )         -->
        <!-- ============================================================== -->
        <profile>
            <id>autoInstallPackage</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.day.jcr.vault</groupId>
                        <artifactId>content-package-maven-plugin</artifactId>
                        <version>1.0.6</version>
                        <executions>
                            <execution>
                                <id>install-package</id>
                                <goals>
                                    <goal>install</goal>
                                </goals>
                                <configuration>
                                    <targetURL>http://${aem.host}:${aem.port}/crx/packmgr/service.jsp</targetURL>
                                    <failOnError>true</failOnError>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ============================================================== -->
        <!-- A U T O I N S T A L L  P A C K A G E  ( P U B L I S H )       -->
        <!-- ============================================================== -->
        <profile>
            <id>autoInstallPackagePublish</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.day.jcr.vault</groupId>
                        <artifactId>content-package-maven-plugin</artifactId>
                        <version>1.0.6</version>
                        <executions>
                            <execution>
                                <id>install-package-publish</id>
                                <goals>
                                    <goal>install</goal>
                                </goals>
                                <configuration>
                                    <targetURL>http://${aem.host}:${aem.publish.port}/crx/packmgr/service.jsp</targetURL>
                                    <failOnError>true</failOnError>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
